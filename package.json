{
  "name": "info-monitor",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/api",
    "packages/shared-contracts"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace @info-monitor/frontend",
    "dev:api": "npm run dev --workspace @info-monitor/api",
    "preview": "bash ./scripts/preview.sh",
    "preview:prepare": "bash ./scripts/preview.sh --prepare-only",
    "db:up": "bash ./scripts/docker-compose.sh up -d postgres",
    "db:down": "bash ./scripts/docker-compose.sh down",
    "docker:build": "bash ./scripts/docker-compose.sh build",
    "docker:build:api": "bash ./scripts/docker-compose.sh build api",
    "docker:build:worker": "bash ./scripts/docker-compose.sh build worker",
    "docker:build:scheduler": "bash ./scripts/docker-compose.sh build scheduler",
    "docker:up": "bash ./scripts/docker-compose.sh up -d",
    "docker:down": "bash ./scripts/docker-compose.sh down",
    "docker:logs": "bash ./scripts/docker-compose.sh logs -f",
    "deploy": "bash ./deploy.sh",
    "deploy:api": "bash ./deploy.sh api",
    "deploy:worker": "bash ./deploy.sh worker",
    "deploy:scheduler": "bash ./deploy.sh scheduler",
    "db:migrate": "bash ./scripts/db-apply-migrations.sh",
    "db:seed:demo": "node ./scripts/db-seed-demo.mjs",
    "db:seed:eastmoney-demo": "node ./scripts/db-seed-eastmoney-stock-demo.mjs",
    "db:seed:figma-demo": "node ./scripts/db-seed-figma-demo.mjs",
    "db:seed:pbc-news-demo": "node ./scripts/db-seed-pbc-news-demo.mjs",
    "db:seed:pbc-open-market-demo": "node ./scripts/db-seed-pbc-open-market-demo.mjs",
    "db:seed:stats-data-release-demo": "node ./scripts/db-seed-stats-data-release-demo.mjs",
    "db:seed:workbench-demo": "npm run db:seed:demo && npm run db:seed:eastmoney-demo && npm run db:seed:figma-demo && npm run db:seed:pbc-news-demo && npm run db:seed:pbc-open-market-demo && npm run db:seed:stats-data-release-demo",
    "db:enqueue:demo": "node ./scripts/db-enqueue-demo-run.mjs",
    "db:enqueue:eastmoney-demo": "node ./scripts/db-enqueue-demo-run.mjs source-eastmoney-moutai-kline theme-eastmoney-moutai",
    "db:enqueue:figma-demo": "node ./scripts/db-enqueue-demo-run.mjs source-figma-release-notes theme-figma-updates",
    "db:enqueue:pbc-news-demo": "node ./scripts/db-enqueue-demo-run.mjs source-pbc-news-list theme-pbc-news",
    "db:enqueue:pbc-open-market-demo": "node ./scripts/db-enqueue-demo-run.mjs source-pbc-open-market theme-pbc-open-market",
    "db:enqueue:stats-data-release-demo": "node ./scripts/db-enqueue-demo-run.mjs source-stats-cpi-release theme-stats-cpi-releases",
    "db:enqueue:workbench-demo": "npm run db:enqueue:demo && npm run db:enqueue:eastmoney-demo && npm run db:enqueue:figma-demo && npm run db:enqueue:pbc-news-demo && npm run db:enqueue:pbc-open-market-demo && npm run db:enqueue:stats-data-release-demo",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint:frontend && npm run lint:api && npm run lint:python-worker && npm run lint:python-scheduler",
    "lint:frontend": "npm run lint --workspace @info-monitor/frontend",
    "lint:api": "npm run lint --workspace @info-monitor/api",
    "lint:python-worker": "apps/python-worker/.venv/bin/python -m ruff check apps/python-worker/src",
    "lint:python-scheduler": "apps/python-scheduler/.venv/bin/python -m ruff check apps/python-scheduler/src",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:frontend": "npm run test --workspace @info-monitor/frontend",
    "test:api": "npm run test --workspace @info-monitor/api",
    "test:python-worker": "apps/python-worker/.venv/bin/python -m pytest apps/python-worker/tests -v"
  }
}
