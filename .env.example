# Shared
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/info_monitor

# Frontend
VITE_API_BASE_URL=http://localhost:3001/api

# Node API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Python worker / scheduler
PYTHON_ENV=development
RAW_STORAGE_DIR=./data/raw
SCHEDULER_POLL_SECONDS=30

# HTTP client (anti-scraping)
REQUEST_TIMEOUT=20
MAX_RETRIES=3
RATE_LIMIT_PER_DOMAIN_PER_SECOND=2
# HTTP_PROXY=
# HTTPS_PROXY=
# USER_AGENT_POOL=

# Meilisearch (required for search UI)
# MEILI_HOST=http://localhost:7700
# MEILI_API_KEY=

# LLM (optional: none | claude | openai | local)
# LLM_PROVIDER=none
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_MAX_TOKENS=1000
# LLM_TIMEOUT_SECONDS=30

# Worker concurrency and lease recovery
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=600
WORKER_MAX_ATTEMPTS=3
WORKER_MAX_RUN_SECONDS=1800

# Persistent archive files (maintenance profile; preview unless --apply is explicit)
# INFO_MONITOR_ARCHIVE_DIR=./data/archive
